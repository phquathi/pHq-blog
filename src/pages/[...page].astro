---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "../components/control/Pagination.astro";
import PostContent from "../components/misc/PostContent.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();

	// 分页路由: /2/ /3/ ...
	const paginated = await paginate(allBlogPosts, { pageSize: PAGE_SIZE });

	// 旧 Hexo 文章路由: /YYYY/MM/DD/<slug>/ （保持历史链接可用）
	// legacyPath 取自 frontmatter 原值（不经 slugify），保证与旧 URL 完全一致
	const legacyRoutes = allBlogPosts
		.filter((post) => post.data.legacyPath)
		.map((post) => ({
			params: { page: post.data.legacyPath! },
			props: { legacyEntry: post },
		}));

	return [...paginated, ...legacyRoutes];
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const legacyEntry = Astro.props.legacyEntry as CollectionEntry<"posts"> | undefined;

const len = page?.data?.length ?? 0;

// 旧文章路径：渲染文章正文，保证历史 URL 直接可用（build 期静态生成，无 JS 跳转）
let LegacyContent: any;
let LegacyHeadings: any;
let LegacyFrontmatter: any;
if (legacyEntry) {
	const render = await legacyEntry.render();
	LegacyContent = render.Content;
	LegacyHeadings = render.headings;
	LegacyFrontmatter = render.remarkPluginFrontmatter;
}
---

{legacyEntry ? (
	<MainGridLayout banner={legacyEntry.data.image} title={legacyEntry.data.title} description={legacyEntry.data.description} lang={legacyEntry.data.lang} setOGTypeArticle={true} headings={LegacyHeadings}>
		<PostContent entry={legacyEntry} Content={LegacyContent} headings={LegacyHeadings} remarkPluginFrontmatter={LegacyFrontmatter} />
	</MainGridLayout>
) : (
	<MainGridLayout>
		<PostPage page={page!}></PostPage>
		<Pagination class="mx-auto onload-animation" page={page!} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
	</MainGridLayout>
)}
