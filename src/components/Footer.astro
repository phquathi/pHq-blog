---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
    <!-- 不蒜子访客统计（沿用旧站统计服务，数据延续） -->
    <div class="transition text-50 text-sm text-center mt-2" data-pagefind-ignore>
        <span>本站总访问量 <span class="bsz-value" data-bsz-key="site_pv"></span> 次</span>
        <span class="ml-1.5">访客数 <span class="bsz-value" data-bsz-key="site_uv"></span> 人</span>
    </div>
</div>

<script>
    // 不蒜子访问统计（自实现 JSONP，直连官方 API）。
    // 背景：官方 busuanzi 脚本用 getElementById 填充，而本页 Footer 有桌面/移动两份实例，
    // 重复 id 会导致只有第一份被填充，且脚本失败时会内联 display:none 隐藏容器，
    // 移动端浏览器还可能截断 referer 使 page_pv 回退成 site_pv，导致数字错乱。
    // 因此这里不加载官方脚本，改为自行请求并用 class 定位填充所有实例：
    // - 容器标签始终可见，不再被脚本隐藏，显示稳定
    // - class + data-bsz-key 精确定位，两个 Footer 实例都会被正确填充
    // - 请求带序号 token，软导航并发时只接受最新响应，避免 page_pv 串位
    // - referrerPolicy=unsafe-url 保证移动端也发送完整路径，page_pv 不会被服务端回退成站点总量
    const w = window as any;
    w.__bszToken = w.__bszToken || 0;
    w.__bszRetries = w.__bszRetries || 0;
    function fetchBusuanziStats() {
        const token = ++w.__bszToken;
        const cb = "BusuanziCallback_" + Math.floor(Math.random() * 1e12);
        const cleanup = () => {
            delete (window as any)[cb];
        };
        (window as any)[cb] = (data: { site_pv?: number; site_uv?: number; page_pv?: number }) => {
            cleanup();
            if (token !== w.__bszToken) return; // 丢弃过期响应
            w.__bszRetries = 0;
            const fill = (key: string, value: number | undefined) => {
                if (value == null) return;
                document
                    .querySelectorAll('.bsz-value[data-bsz-key="' + key + '"]')
                    .forEach((el) => {
                        el.textContent = String(value);
                    });
            };
            fill("site_pv", data.site_pv);
            fill("site_uv", data.site_uv);
            fill("page_pv", data.page_pv);
        };
        const script = document.createElement("script");
        script.src = "https://busuanzi.ibruce.info/busuanzi?jsonpCallback=" + cb;
        script.async = true;
        script.referrerPolicy = "unsafe-url";
        script.onerror = () => {
            cleanup();
            if (token !== w.__bszToken) return;
            // 失败重试一次，仍失败则保持标签显示（数字留空），不做任何隐藏
            if (w.__bszRetries < 1) {
                w.__bszRetries += 1;
                setTimeout(fetchBusuanziStats, 1500);
            }
        };
        document.head.appendChild(script);
    }
    fetchBusuanziStats();
    function setupBusuanziSwupHook() {
        if (window.swup) {
            window.swup.hooks.on("content:replace", () => fetchBusuanziStats());
        } else {
            document.addEventListener("swup:enable", setupBusuanziSwupHook, { once: true });
        }
    }
    setupBusuanziSwupHook();
</script>